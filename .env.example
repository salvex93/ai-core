# =============================================================================
# AI-CORE — Variables de entorno por proveedor
# Copia este archivo a .env y completa solo las claves que vayas a usar.
# El ModelRegistry detecta automaticamente cuales proveedores estan disponibles.
# =============================================================================

# -----------------------------------------------------------------------------
# TIER 0 — GRATUITO (siempre configurar primero)
# -----------------------------------------------------------------------------

# Gemini 3.5 Flash — free tier en API. RPM/RPD exactos: verificar ai.google.dev/gemini-api/docs/rate-limits.
# Obtener en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# TIER 1 — Anthropic Claude (proveedor principal)
# -----------------------------------------------------------------------------

# Claude Haiku/Sonnet/Opus via API.
# La misma clave que usa Claude Code en sesion activa.
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# TIER 2 — Proveedores alternativos (OpenAI-compatible)
# Todos usan el mismo adapter en ModelRegistry. Agregar la clave activa el proveedor.
# Rol dual: ahorro de costo en tareas simples Y verificador cross-model
# (ver skill cross-model-verifier — CrossVerifier.js exige proveedor distinto
# al que genero el diff para validar un fix, nunca el mismo proveedor del actor).
# -----------------------------------------------------------------------------

# OpenAI — GPT-4o, o1, o3
# Obtener en: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# DeepSeek — DeepSeek-V3, R1. API compatible con OpenAI SDK.
# Obtener en: https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Kimi (Moonshot AI) — Kimi K2. Contexto 256k. API compatible con OpenAI SDK.
# Obtener en: https://platform.kimi.ai
KIMI_API_KEY=

# -----------------------------------------------------------------------------
# Configuracion opcional
# -----------------------------------------------------------------------------

# Ruta al directorio de documentacion interna del proyecto anfitrion (RAG local).
DOCS_PATH=./docs
