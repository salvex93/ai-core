{
  "name": "ai-core",
  "version": "3.9.0",
  "description": "AI-CORE by salvex93. Nucleo Centralizado de Agentes para proyectos de desarrollo. Submodulo Git con reglas globales, skills y scripts de orquestacion.",
  "private": true,
  "scripts": {
    "init-backlog": "node scripts/init-backlog.js",
    "anthropic-bridge": "node scripts/anthropic-bridge.js",
