{
  "name": "ai-core",
  "version": "3.33.1",
  "description": "AI-CORE by salvex93. Nucleo Centralizado de Agentes para proyectos de desarrollo. Submodulo Git con reglas globales, skills y scripts de orquestacion.",
  "private": true,
  "scripts": {
    "postinstall": "node .claude/bin/setup-settings.js",
    "init-backlog": "node scripts/init-backlog.js",
    "anthropic-bridge": "node scripts/anthropic-bridge.js",
    "mcp-gemini": "node scripts/mcp-gemini.js",
    "query-backlog": "node scripts/query-backlog.js",
    "dry-run": "node scripts/dry-run-cost-sim.js",
    "mcp-anthropic": "node scripts/mcp-anthropic.js",
    "map": "node .claude/bin/generate-map.js",
    "test": "node --test --test-concurrency=1",
    "token-metrics": "node tests/token-metrics.js",
    "setup": "node .claude/bin/setup-settings.js",
    "validate-globals": "node .claude/bin/validate-globals.js",
    "validate-agents": "node .claude/bin/validate-agents.js",
    "audit-market": "node .claude/bin/audit-market.js",
    "score": "node .claude/bin/aiops-score.js",
    "score-report": "node .claude/bin/aiops-score.js --report",
    "migrate": "node scripts/migrator.js",
    "migrate-dry": "node scripts/migrator.js --dry-run",
    "rollback-skill": "node scripts/rollback-skill.js",
    "rollback-agent": "node scripts/rollback-agent.js",
    "update": "node scripts/update.js",
    "memory-index": "node .claude/bin/memory-index.js index",
    "memory-query": "node .claude/bin/memory-index.js query",
    "memory-status": "node .claude/bin/memory-index.js status",
    "agent-report": "node .claude/bin/agent-metrics.js report",
    "agent-report-full": "node .claude/bin/agent-metrics.js report --full",
    "eval-skills": "node .claude/evals/run-all.js",
    "sandbox": "node scripts/sandbox.js",
    "scan-secrets-history": "node .claude/bin/git-history-secrets-scan.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@google/genai": "^2.15.0",
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "allowScripts": {
    "protobufjs@7.6.5": true,
    "@google/genai@2.15.0": true
  }
}
