# Dependencias Node.js
node_modules/

# Variables de entorno — nunca al repositorio
# Patron generico .env* como red de seguridad (cubre .env.test, .env.staging,
# etc. sin depender de listar cada variante explicita) + las 4 ya conocidas
# por claridad documental.
.env*
.env
.env.local
.env.development
.env.production

# Archivos de configuracion de workspace generados localmente
NOTEBOOK_SETUP.md

# Archivos de configuracion Claude Code con credenciales personales
.claude/settings.local.json
.claude.json

# settings.json contiene rutas absolutas de la maquina donde se genero
# (via setup-settings.js) — versionarlo rompe el proyecto en cualquier otro
# equipo o usuario. Se regenera local con `npm run setup` (postinstall).
.claude/settings.json

# Credenciales/claves que no deberian versionarse nunca, aunque hoy no
# existan en el repo — red de seguridad preventiva.
*.pem
*.key
*.p12
credentials.json

# Scripts de automatizacion premium — nunca al repositorio publico
scripts/premium/

# Artefactos de sesion generados en runtime — no versionables
.claude/HEALTH_REPORT.md
.claude/TO_GEMINI.md
.claude/TOKEN_METRICS.json
.claude/AGENT_METRICS.json
.claude/MCP_INTEGRITY_BASELINE.json
.claude/models-cache.json
.claude/CONTEXT_MAP.json
.claude/EVENTS_QUEUE.json
.claude/_issue_tmp_*.md
.claude/.current_role
.claude/AGENT_SNAPSHOTS/
